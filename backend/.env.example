# Copy this file to ".env" (same folder) and fill in your key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used automatically if the main model returns 503 / overloaded
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Optional overrides
# TERRAPULSE_THERMAL_THRESHOLD_K=330
# TERRAPULSE_ML_THRESHOLD=0.5
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# CORS_ORIGINS=http://localhost:5173

# Forest-office sign-in (set your own; if OFFICE_PASSWORD is empty a built-in demo account is used)
OFFICE_USERNAME=forest.officer
OFFICE_PASSWORD=
OFFICE_NAME=Forest Office
# AUTH_SECRET=any-long-random-string
# AUTH_TOKEN_HOURS=8

# Community alerts - DEMO delivery (all optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# Shown in alerts only if you set it (a real helpline number). Never invented.
# ALERT_HELPLINE=
